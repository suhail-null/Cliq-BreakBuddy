{
  "manifest_version": 3,
  "name": "Cliq BreakBuddy",
  "version": "1.3.0",
  "minimum_chrome_version": "120",
  "description": "Schedule Cliq Break/Back and custom messages with optional Telegram delivery reports in a persistent side panel.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "idle",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://cliq.zoho.com/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open BreakBuddy side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open BreakBuddy side panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cliq.zoho.com/company/717321507/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}